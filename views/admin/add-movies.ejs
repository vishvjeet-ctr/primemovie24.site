<% let body = ''; 
body += '<div class="form-header">'; 
body += '<h1>Add New Movie</h1>'; 
body += '<a href="/admin/movies" class="back-link">← Back to Movies</a>'; 
body += '</div>'; 
body += '<div class="form-container">'; 
body += '<form action="/admin/add" method="POST" class="movie-form">'; 
body += '<div class="form-group"><label for="title">Movie Title *</label>'; 
body += '<input type="text" id="title" name="title" class="form-input" placeholder="Enter movie title" required></div>';
body += '<div class="form-group"><label for="poster">Poster Image URL *</label>'; 
body += '<input type="url" id="poster" name="poster" class="form-input" placeholder="https://example.com/poster.jpg" required>';
body += '<div class="poster-preview" id="posterPreviewContainer" style="display: none; margin-top: 1rem;">'; 
body += '<img src="" alt="Preview" id="posterPreview" style="max-width: 300px; border-radius: 8px;"></div></div>'; 
body += '<div class="form-group"><label>Download Links *</label>'; 
body += '<div id="downloadLinksContainer">'; 
body += '<div class="download-link-item" style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem; align-items: flex-start;">'; 
body += '<div style="flex: 1;"><input type="text" name="linkNames" class="form-input" placeholder="Link Name (e.g., Server 1, 720p)" style="margin-bottom: 0.5rem;"></div>'; 
body += '<div style="flex: 2;"><input type="url" name="linkUrls" class="form-input" placeholder="https://example.com/download" required></div>'; 
body += '<button type="button" class="btn-remove-link" onclick="removeDownloadLink(this)" style="display: none; padding: 0.5rem 0.75rem; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; align-self: flex-end;">Remove</button>'; 
body += '</div>'; 
body += '</div>'; 
body += '<button type="button" id="addDownloadLinkBtn" class="btn-secondary" style="margin-top: 0.5rem; padding: 0.5rem 1rem; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">+ Add Another Download Link</button></div>';
body += '<div class="form-group"><label>Categories *</label>'; 
body += '<div class="checkbox-group" style="display: flex; flex-direction: column; gap: 0.5rem;">'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="trending" style="margin-right: 0.5rem;">'; 
body += '<span>Trending</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="bollywood" style="margin-right: 0.5rem;">'; 
body += '<span>Bollywood</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="hollywood" style="margin-right: 0.5rem;">'; 
body += '<span>Hollywood</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="marvel" style="margin-right: 0.5rem;">'; 
body += '<span>Marvel</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="dc" style="margin-right: 0.5rem;">'; 
body += '<span>DC</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="south" style="margin-right: 0.5rem;">'; 
body += '<span>South Indian</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="webseries" style="margin-right: 0.5rem;">'; 
body += '<span>Web Series</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="netflixprime" style="margin-right: 0.5rem;">'; 
body += '<span>On Netflix & Prime</span></label>'; 
body += '<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">'; 
body += '<input type="checkbox" name="categories" value="animation" style="margin-right: 0.5rem;">'; 
body += '<span>Animation</span></label>'; 
body += '</div></div>'; 
body += '<div class="form-group"><label for="rating">Rating (0-10)</label>'; 
body += '<input type="number" id="rating" name="rating" class="form-input" placeholder="0" min="0" max="10" step="0.1"></div>';
body += '<div class="form-actions">'; 
body += '<button type="submit" class="btn btn-primary">Add Movie</button>';
body += '<a href="/admin/movies" class="btn btn-secondary">Cancel</a></div>'; 
body += '</form></div>'; 
body += '<script>'; 
body += 'document.getElementById("poster").addEventListener("input", function (e) {'; 
body += 'const preview = document.getElementById("posterPreview");'; 
body += 'const container = document.getElementById("posterPreviewContainer");'; 
body += 'if (e.target.value) { preview.src = e.target.value; container.style.display = "block"; }'; 
body += 'else { container.style.display = "none"; }'; 
body += '});'; 
body += 'function addDownloadLink() {'; 
body += 'const container = document.getElementById("downloadLinksContainer");'; 
body += 'const newItem = document.createElement("div");'; 
body += 'newItem.className = "download-link-item";'; 
body += 'newItem.style.cssText = "display: flex; gap: 0.5rem; margin-bottom: 0.5rem; align-items: flex-start;";'; 
body += 'newItem.innerHTML = "<div style=\\"flex: 1;\\"><input type=\\"text\\" name=\\"linkNames\\" class=\\"form-input\\" placeholder=\\"Link Name (e.g., Server 1, 720p)\\" style=\\"margin-bottom: 0.5rem;\\"></div><div style=\\"flex: 2;\\"><input type=\\"url\\" name=\\"linkUrls\\" class=\\"form-input\\" placeholder=\\"https://example.com/download\\" required></div><button type=\\"button\\" class=\\"btn-remove-link\\" onclick=\\"removeDownloadLink(this)\\" style=\\"padding: 0.5rem 0.75rem; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; align-self: flex-end;\\">Remove</button>";'; 
body += 'container.appendChild(newItem);'; 
body += 'updateRemoveButtons();'; 
body += '}'; 
body += 'function removeDownloadLink(button) {'; 
body += 'button.parentElement.remove();'; 
body += 'updateRemoveButtons();'; 
body += '}'; 
body += 'function updateRemoveButtons() {'; 
body += 'const items = document.querySelectorAll(".download-link-item");'; 
body += 'const removeButtons = document.querySelectorAll(".btn-remove-link");'; 
body += 'removeButtons.forEach(btn => {'; 
body += 'btn.style.display = items.length > 1 ? "inline-block" : "none";'; 
body += '});'; 
body += '}'; 
body += 'document.getElementById("addDownloadLinkBtn").addEventListener("click", addDownloadLink);'; 
body += 'updateRemoveButtons();'; 
body += '</script>'; 
%>
<%- include('layout', { body: body, page: 'add' }) %>
