<% 
    let body = '';
    body += '<div class="form-header">';
    body += '<h1>Edit Movie</h1>';
    body += '<a href="/admin/movies" class="back-link">← Back to Movies</a>';
    body += '</div>';
    body += '<div class="form-container">';
    body += '<form action="/admin/movies/' + movie._id + '?_method=PUT" method="POST" class="movie-form">';
    body += '<div class="form-group"><label for="title">Movie Title *</label>';
    body += '<input type="text" id="title" name="title" class="form-input" value="' + movie.title.replace(/"/g, '&quot;') + '" required></div>';
    body += '<div class="form-group"><label for="poster">Poster Image URL *</label>';
    body += '<input type="url" id="poster" name="poster" class="form-input" value="' + movie.poster.replace(/"/g, '&quot;') + '" required>';
    body += '<div class="poster-preview"><img src="' + movie.poster.replace(/"/g, '&quot;') + '" alt="Preview" id="posterPreview"></div></div>';
    body += '<div class="form-group"><label for="downloadLink">Download Link *</label>';
    body += '<input type="url" id="downloadLink" name="downloadLink" class="form-input" value="' + movie.downloadLink.replace(/"/g, '&quot;') + '" required></div>';
    body += '<div class="form-group"><label for="categories">Categories *</label>';
    body += '<div class="checkbox-group">';
    const categories = ['trending', 'bollywood', 'hollywood', 'marvel', 'dc', 'south'];
    categories.forEach(cat => {
        const isChecked = movie.categories && movie.categories.includes(cat);
        body += '<label class="checkbox-label">';
        body += '<input type="checkbox" name="categories" value="' + cat + '"' + (isChecked ? ' checked' : '') + '>';
        body += '<span class="checkmark"></span>' + cat.charAt(0).toUpperCase() + cat.slice(1);
        body += '</label>';
    });
    body += '</div></div>';
    body += '<div class="form-group"><label for="rating">Rating (0-10)</label>';
    body += '<input type="number" id="rating" name="rating" class="form-input" value="' + (movie.rating || 0) + '" min="0" max="10" step="0.1"></div>';
    body += '<div class="form-actions">';
    body += '<button type="submit" class="btn btn-primary">Update Movie</button>';
    body += '<a href="/admin/movies" class="btn btn-secondary">Cancel</a></div>';
    body += '</form></div>';
    body += '<script>';
    body += 'document.getElementById("poster").addEventListener("input", function(e) {';
    body += 'document.getElementById("posterPreview").src = e.target.value || "' + movie.poster.replace(/"/g, '\\\\"') + '";';
    body += '});';
    body += '</script>';
%>
<%- include('layout', { body: body, page: 'edit' }) %>
