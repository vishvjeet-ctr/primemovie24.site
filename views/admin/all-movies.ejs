<% 
    let body = '';
    body += '<div class="table-header">';
    body += '<h1>All Movies</h1>';
    body += '<a href="/admin/add" class="add-btn">+ Add New Movie</a>';
    body += '</div>';
    body += '<div class="table-container">';
    if (movies.length > 0) {
        body += '<table class="movies-table">';
        body += '<thead><tr><th>Poster</th><th>Title</th><th>Category</th><th>Rating</th><th>Created</th><th>Actions</th></tr></thead>';
        body += '<tbody>';
        movies.forEach(movie => {
            body += '<tr>';
            body += '<td class="poster-cell"><img src="' + movie.poster + '" alt="' + movie.title + '" class="table-poster"></td>';
            body += '<td class="title-cell">' + movie.title + '</td>';
            body += '<td class="category-cell"><span class="category-badge category-' + movie.category + '">' + movie.category.charAt(0).toUpperCase() + movie.category.slice(1) + '</span></td>';
            body += '<td class="rating-cell">' + (movie.rating > 0 ? '⭐ ' + movie.rating : '-') + '</td>';
            body += '<td class="date-cell">' + new Date(movie.createdAt).toLocaleDateString() + '</td>';
            body += '<td class="actions-cell"><a href="/admin/movies/' + movie._id + '/edit" class="btn-edit">Edit</a>';
            body += '<form action="/admin/movies/' + movie._id + '?_method=DELETE" method="POST" class="delete-form" style="display: inline;">';
            body += '<button type="submit" class="btn-delete" onclick="return confirm(\'Are you sure you want to delete this movie?\')">Delete</button></form></td>';
            body += '</tr>';
        });
        body += '</tbody></table>';
    } else {
        body += '<div class="empty-state"><p>No movies found. <a href="/admin/add">Add your first movie</a></p></div>';
    }
    body += '</div>';
%>
<%- include('layout', { body: body, page: 'movies' }) %>
