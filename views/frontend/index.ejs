<%- include('../partials/header') %>

<main class="main-content">
    <!-- Trending Movies Section -->
    <section class="movie-section trending-section">
        <h2 class="section-title">Trending Movies</h2>
        <div class="trending-container">
            <% if (trendingMovies.length > 0) { %>
                <% trendingMovies.forEach((movie, index) => { %>
                    <div class="trending-movie-card">
                        <div class="trending-rank-number"><%= index + 1 %></div>
                        <a href="/movie/<%= movie._id %>" class="trending-movie-link">
                            <div class="trending-poster-wrapper">
                                <img src="<%= movie.poster %>" alt="<%= movie.title %>" class="trending-poster">
                            </div>
                            <div class="trending-movie-info">
                                <h3 class="trending-movie-title"><%= movie.title %></h3>
                            </div>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="no-movies">No trending movies available</p>
            <% } %>
        </div>
    </section>

    <!-- On Netflix & Prime Section -->
    <section class="movie-section">
        <h2 class="section-title">On Netflix & Prime</h2>
        <div class="movies-grid" data-category="netflixprime">
            <% if (netflixprimeMovies.length > 0) { %>
                <% netflixprimeMovies.forEach(movie => { %>
                    <div class="movie-card">
                        <a href="/movie/<%= movie._id %>" class="movie-link">
                            <img src="<%= movie.poster %>" alt="<%= movie.title %>" class="movie-poster">
                        </a>
                        <h3 class="movie-title-below"><%= movie.title %></h3>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="no-movies">No movies available on Netflix & Prime</p>
            <% } %>
        </div>
    </section>

